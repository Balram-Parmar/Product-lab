# PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://tweets:change-me@localhost:5432/tweetsdb

# Flask
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
PAGE_SIZE=25

# X API bearer token (kept for reference; this build reads mock.json instead)
X_BEARER_TOKEN=
